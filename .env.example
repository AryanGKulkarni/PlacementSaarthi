# Copy to .env and change values. docker compose reads .env automatically.
POSTGRES_USER=placement
POSTGRES_PASSWORD=placement
POSTGRES_DB=placement_db

RABBITMQ_USER=placement
RABBITMQ_PASSWORD=placement

# Signs login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me

# Default admin, created on startup if no admin user exists.
# Change the password for anything beyond local development.
ADMIN_EMAIL=admin@admin.com
ADMIN_PASSWORD=admin

# For running the backend/worker locally (outside Docker) against the containers:
# DATABASE_URL=postgresql+psycopg://placement:placement@localhost:5432/placement_db
# RABBITMQ_URL=amqp://placement:placement@localhost:5672/
